# IntímaGuard — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# LLM API keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# Judge model — change this for leaderboard runs to avoid conflict of interest
# e.g. use gpt-4o when evaluating Claude models, and vice versa
JUDGE_MODEL=claude-sonnet-4-6

# IntímaGuard API key (for /api/v1/* endpoints — leave blank to disable auth in dev)
INTIMAGUARD_API_KEY=

# Geo-blocking (set to false for local dev)
GEOBLOCK_ENABLED=false
